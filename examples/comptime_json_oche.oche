struct User {
  name: String,
  age: Int,
  active: Bool,
}

struct Batch {
  counts: List<Int>,
  labels: List<List<String>>,
}

struct Envelope {
  owner: User,
  batches: List<Batch>,
}

// `json` is implemented by stdlib/json.oche and executed in the Dart VM.
comptime jsonEncode(User)

comptime jsonDecode(User)

comptime jsonEncode(Batch)

comptime jsonDecode(Batch)

comptime jsonEncode(Envelope)

comptime jsonDecode(Envelope)

fn encode_user(name: String, age: Int, active: Bool) -> String {
  User { name: name, age: age, active: active }.toJson()
}

fn round_trip(source: String) -> String {
  match User.fromJson(source) {
    Ok(user) => user.toJson(),
    Err(error) => error,
  }
}

fn round_trip_batch(source: String) -> String {
  match Batch.fromJson(source) {
    Ok(batch) => batch.toJson(),
    Err(error) => error,
  }
}

fn round_trip_envelope(source: String) -> String {
  match Envelope.fromJson(source) {
    Ok(envelope) => envelope.toJson(),
    Err(error) => error,
  }
}
